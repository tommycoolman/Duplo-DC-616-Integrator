    main_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=(10, 5))

    # Frame to hold the PNG image to the left of the log pane
    image_frame = tk.Frame(main_frame)
    image_frame.pack(side=tk.LEFT, fill=tk.Y, padx=(0, 10))

    try:
        logo_image = tk.PhotoImage(data=PNG_DATA)
        logo_label = tk.Label(image_frame, image=logo_image, borderwidth=0)
        logo_label.image = logo_image
        logo_label.pack(anchor=tk.NW)
    except tk.TclError:
        logo_label = tk.Label(image_frame, text="Image unavailable", anchor=tk.CENTER)
        logo_label.pack(anchor=tk.CENTER, padx=10, pady=10)

    # Frame to hold text widget and scrollbars
    text_frame = tk.Frame(main_frame)
    text_frame.pack(side=tk.LEFT, fill=tk.BOTH, expand=True)

    # Create horizontal scrollbar
    h_scrollbar = tk.Scrollbar(text_frame, orient=tk.HORIZONTAL)
    h_scrollbar.pack(side=tk.BOTTOM, fill=tk.X)

    # Create log_box with wrap=NONE to prevent word wrapping
    log_box = tk.Text(
        text_frame,
        wrap=tk.NONE,
        state="disabled",
        height=12,
        xscrollcommand=h_scrollbar.set,
        font=("Courier New", 9),
    )
    log_box.pack(side=tk.TOP, fill=tk.BOTH, expand=True)
    h_scrollbar.config(command=log_box.xview)

    button_frame = tk.Frame(root)
    button_frame.pack(pady=(0, 10))

    exit_button = tk.Button(button_frame, text="Exit", command=root.destroy)
    exit_button.pack(side=tk.LEFT)
    
    global seen_files
    seen_files = get_current_files(WATCH_FOLDER)
    root.after(1000, scan_folder, log_box, root)
    
    if not Path(import_dir).is_dir():
        display_message(log_box, f"   Error: Path not found, Duplo DC618 XML_Import")
    else:
        display_message(log_box, f" Monitor: Duplo DC618 XML_Import")
        # 'Duplo DC618 XML_Import' should always be empty on startup

    if not Path(duplo_dir).is_dir():
        display_message(log_box, f"   Error: Path not found, DC-618 PC Controller V1.04")

    if not Path(job_output).is_dir():
        display_message(log_box, f"   Error: Path not found, Duplo DC616 Output")

    if not Path(export_dir).is_dir():
        display_message(log_box, f"   Error: Path not found, Duplo DC618 XML_Export")
    

    root.mainloop()


if __name__ == "__main__":
    main()

