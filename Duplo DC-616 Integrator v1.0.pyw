def convert_xml_to_jobfile(input_file, log_box) -> None:
    job_data = parse_job_data(input_file)
    cuts, slits, creases = convert(job_data)

    output_file = re.sub(r'.xml', '.j616', input_file.name, count=1)
    output_file = job_output + job_data['job_no'] + ". " + output_file
    
    # compute sheet height and width
    sheet_width = int(round(job_data['media_size'][0] / 72 * 25.4,1) * 10)
    sheet_height = int(round(job_data['media_size'][1] / 72 * 25.4,1) * 10)
    
    # compute card height and width
    card_width = int(round(job_data['card_size'][0] / 72 * 25.4,1) * 10)
    card_height = int(round(job_data['card_size'][1] / 72 * 25.4,1) * 10)
        
    file_size = 192
    print(output_file)    
    with open(output_file, "wb") as f:
        f.truncate(file_size)
        
        # write job number
        f.seek(0)
        job_number = int(job_data['job_no'])
        f.write(job_number.to_bytes(2, byteorder='little'))

        # write job name
        f.seek(82)
        job_data['job_name'] = job_data['job_name'][:13]
        f.write(job_data['job_name'].encode("utf-8"))
        
        # sheet width
        f.seek(4)
        f.write(sheet_width.to_bytes(2, byteorder='little'))

        # sheet height
        f.seek(2)
        f.write(sheet_height.to_bytes(2, byteorder='little'))
        f.seek(178)
        f.write(sheet_height.to_bytes(2, byteorder='little'))
        f.seek(180)
        f.write(sheet_height.to_bytes(2, byteorder='little'))

        # card width
        f.seek(146)
        f.write(card_width.to_bytes(2, byteorder='little'))

        # card height
        f.seek(148)
        f.write(card_height.to_bytes(2, byteorder='little'))

        
        # Write cuts to file
        offset = 20
        for cut in cuts:
            f.seek(offset)

            raw_data = cut.to_bytes(2, byteorder='little')
            f.write(raw_data)

            offset+=2
            if offset > 48: # cuts are not stored in one contiguous block
                offset = 90

        # Write slits to file
        offset = [8,12,16,10,14,18] # slits are stored contiguous, but not in logical order
        offset_count = 0
        for slit in slits:
            f.seek(offset[offset_count])

            raw_data = slit.to_bytes(2, byteorder='little')
            f.write(raw_data)

            offset_count += 1

        # Write creases to file
        offset = 50
        for crease in creases:
            f.seek(offset)
            raw_data = crease.to_bytes(2, byteorder='little')
            f.write(raw_data)

            offset+=2
            if offset > 68: # creases are not stored in one contiguous block
                offset = 116
        
        # default functions
        f.seek(80)
        f.write(b'\x66')
        f.write(b'\x01')     

        os.remove(input_file)
        job_data['job_name']
        display_message(log_box, f"   Saved: Job {job_data['job_no']}. {job_data['job_name']}.j616")

def parse_job_data(xml_path: Path) -> dict:
    tree = ET.parse(xml_path)
    root = tree.getroot()

    job_data = {}
    
    # 'blocks' are what Fiery calls each imposed card
    job_data['blocks'] = {}
    for block in root.findall(".//CutBlock"):
        block_name = block.get("BlockName")
        if not block_name:
            continue

        block_size = block.get("BlockSize", "")
        block_position = block.get("BlockPosition", "")

        job_data['blocks'][block_name] = {
            "block_size": [float(value) for value in block_size.split()] if block_size else [],
            "block_position": [float(value) for value in block_position.split()] if block_position else [],
        }

    # Fiery exports creases relative to block
    job_data['creases_relative'] = []
    for crease in root.findall(".//Crease"):
        job_data['creases_relative'].append(crease.get("PositionY"))
        
    job_data['job_name']    = root.get('JobName')
    job_data['job_no']      = root.get('JobNo')
    job_data['device']      = root.get('Device')
    job_data['card_size']   = [float(value) for value in block_size.split()]
    job_data['media_size']  = [float(value) for value in root.get('MediaSize').split()]

    return job_data

# calculate slits cuts creases, convert to millimeters
def convert(job_data) -> list:
    
    cuts = [];
    for block in job_data['blocks']:
        # A zero here means the art flush to top
        if not job_data['blocks'][block]['block_position'][1] == 0:
            cuts.append(job_data['blocks'][block]['block_position'][1])

        # If the cut is equal to the sheet height, the art is flush to bottom
        if not job_data['media_size'][1] == (job_data['blocks'][block]['block_position'][1]+job_data['blocks'][block]['block_size'][1]):
            cuts.append(job_data['blocks'][block]['block_position'][1]+job_data['blocks'][block]['block_size'][1])

    # dedupe and sort
    cuts = list(dict.fromkeys(cuts))
    cuts.sort()

    slits = []
    for block in job_data['blocks']:
        
        # A zero here means the art is flush left
        if not job_data['blocks'][block]['block_position'][0] == 0:
            slits.append(job_data['blocks'][block]['block_position'][0])
        
        # If the slit is equal to the sheet width, the art is flush right
        if not job_data['media_size'][0] == (job_data['blocks'][block]['block_position'][0]+job_data['blocks'][block]['block_size'][0]):
            slits.append(job_data['blocks'][block]['block_position'][0]+job_data['blocks'][block]['block_size'][0])

    # dedupe and sort
    slits = list(dict.fromkeys(slits))
    slits.sort()

    # convert relative crease positions into absolute sheet position
    creases = []
    for block in job_data['blocks']:
        for crease in job_data['creases_relative']:
            creases.append(float(crease) + job_data['blocks'][block]['block_position'][1])

    # dedupe and sort
    creases = list(dict.fromkeys(creases))
    creases.sort()

    # Duplo job position data is stored in 1/10 millimeters, example: 215.5mm is 2155
    # convert from points to inches to millimeters, round to nearest 10th, multiply by 10
    cuts    = [int(round(cut / 72 * 25.4,1) * 10) for cut in cuts]
    slits   = [int(round(slit / 72 * 25.4,1) * 10) for slit in slits]
    creases = [int(round(crease / 72 * 25.4,1) * 10) for crease in creases]

    # A bug or mistake causing some duplicate values?  Run dedupe and sort again after rounding.
    cuts = list(dict.fromkeys(cuts))
    cuts.sort()
    slits = list(dict.fromkeys(slits))
    slits.sort()
    creases = list(dict.fromkeys(creases))
    creases.sort()

    return cuts, slits, creases

def process_request(log_box):
    # Open DuploRequest.xml created by Fiery Imposer
    request_tree = ET.parse(Path(import_dir + "DuploRequest.xml"))
    root = request_tree.getroot()

    # Copy FinisherRequest
    for request in root.findall('FinisherRequest'):
        request_type    = request.get('RequestType')
        description     = request.get('Description')
        hostname        = request.get("ImposeHostName")
        request_id      = request.get('RequestID')
        
    shutil.move(Path(import_dir + "DuploRequest.xml") , Path(duplo_dir + "DuploRequest.xml"))

    if not Path(xml_log_path).is_file():
        xml_log_data = '<?xml version="1.0" encoding="UTF-8"?>\n<DuploDCLog>\n</DuploDCLog>\n'
        with open(xml_log_path, "w") as f:
            f.write(xml_log_data)

    # Read XmlLog.xml, root is DuploDCLog
    log_tree = ET.parse(xml_log_path)
    log_root = log_tree.getroot()

    # Append new request to XmlLog.xml
    new_log = ET.Element("FinisherRequestLog")
    new_log.set('RequestType', request_type)
    new_log.set('Response', 'False')
    new_log.set('DuploFinisherID', '000000000')
    new_log.set('Device', 'DC-618')
    #new_log.set('Description', description)
    new_log.set('ImposeHostName', hostname)
    new_log.set('RequestID', request_id)

    ET.indent(log_root, space="  ", level=0)
    log_root.append(new_log)
    log_tree.write(xml_log_path, encoding="utf-8", xml_declaration=True)
    
    display_message(log_box, f"  Parsed: DuploRequest.xml")

def process_job(log_box, filename):
    # Wait for Fiery to upload Job information

    # Open and parse new job XML
    # Open DuploRequest.xml created by Fiery Imposer
    job_tree = ET.parse(Path(import_dir + filename))
    job_root = job_tree.getroot()

    # Attributes from root, DuploDCJobTemplate
    job_info = {}
    job_info['ImposeTemplate']      = 'True'
    job_info['Validation']          = 'True'
    job_info['JobNo']               = job_root.get('JobNo')
    job_info['JobName']             = job_root.get('JobName')

    # Attributes from ImposeSetting
    impose_setting = job_root.find('ImposeSetting') 
    job_info['SaveJobQueue']     = impose_setting.get('SaveJobQueue')
    job_info['ImposeHostName']      = impose_setting.get('ImposeHostName')
    job_info['RequestID']           = impose_setting.get('RequestID')
    job_info['HasJobImage']         = impose_setting.get('HasJobImage')

    # Append new job to XmlLog.xml

    # Read XmlLog.xml again, root is DuploDCLog
    log_tree = ET.parse(xml_log_path)
    log_root = log_tree.getroot()

    new_job_log = ET.Element("JobLog")
    new_job_log.set('ImposeTemplate', job_info['ImposeTemplate'])
    new_job_log.set('Validation', job_info['Validation'])
    new_job_log.set('JobNo', job_info['JobNo'])
    new_job_log.set('JobName', job_info['JobName'])
    new_job_log.set('SaveJobQueue', job_info['SaveJobQueue'])
    new_job_log.set('ImposeHostName', job_info['ImposeHostName'])
    new_job_log.set('RequestID', job_info['RequestID'])
    new_job_log.set('HasJobImage', job_info['HasJobImage'])

    log_root.append(new_job_log)
    log_tree.write(Path(xml_log_path), encoding="utf-8", xml_declaration=True)    
            
    convert_xml_to_jobfile(Path(import_dir + filename), log_box)

def display_message(text_widget, message):
    #timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    timestamp = datetime.now().strftime("%H:%M:%S")
    text_widget.configure(state="normal")
    text_widget.insert(tk.END, f"[{timestamp}] {message}\n")
    text_widget.yview(tk.END)


def get_current_files(folder):
    current_files = set()
    for root, _, files in os.walk(folder):
        for filename in files:
            path = os.path.join(root, filename)
            rel_path = os.path.relpath(path, folder)
            current_files.add(rel_path)
    return current_files


def scan_folder(log_box, root_window):
    global seen_files
    
    current_files = get_current_files(WATCH_FOLDER)
    new_files = sorted(current_files - seen_files)

    for relative_path in new_files:
        display_message(log_box, f"Detected: {relative_path}")
        
        if relative_path == "DuploRequest.xml": # XML is a request file
            process_request(log_box)
        elif relative_path.endswith(".xml"):    # Any other XML is a job file
            process_job(log_box, relative_path)

    seen_files = current_files
    root_window.after(2000, scan_folder, log_box, root_window)

def main():
    current_files = get_current_files(WATCH_FOLDER)

    for file in current_files:
        if file.endswith(".xml"):    # delete all XML files in import folder on startup
